      "backbones": [
        { "provider": "anthropic", "model": "claude-sonnet-4-20250514", "apiKey": "${ANTHROPIC_API_KEY}" },
        { "provider": "openai", "model": "gpt-4o-2024-08-06", "apiKey": "${OPENAI_API_KEY}" },
        { "provider": "openrouter", "model": "google/gemini-2.5-flash-preview-04-17", "apiKey": "${OPENROUTER_API_KEY}" }
      ],
      "params": {}
    },
    {
      "id": "magicore",
      "name": "MAgICoRe (2 rounds)",
      "backbones": [{ "provider": "anthropic", "model": "claude-sonnet-4-20250514", "apiKey": "${ANTHROPIC_API_KEY}" }],
      "params": { "rounds": 2 }
    },
    {
      "id": "debate",
      "name": "Debate (2 rounds + synthesis)",
      "backbones": [{ "provider": "anthropic", "model": "claude-sonnet-4-20250514", "apiKey": "${ANTHROPIC_API_KEY}" }],
      "params": { "debateRounds": 2 }
    },
    {
      "id": "moa",
      "name": "Mixture-of-Agents (3 models → aggregator)",
      "backbones": [
        { "provider": "anthropic", "model": "claude-sonnet-4-20250514", "apiKey": "${ANTHROPIC_API_KEY}" },
        { "provider": "openai", "model": "gpt-4o-2024-08-06", "apiKey": "${OPENAI_API_KEY}" },
        { "provider": "openrouter", "model": "google/gemini-2.5-flash-preview-04-17", "apiKey": "${OPENROUTER_API_KEY}" }
      ],
      "params": {}
    }
  ],
  "budget": {
    "tokenCap": 50000,
    "wallClockSeconds": 300,
    "evalCpuSeconds": 60,
    "evalCallCap": 25
  },
  "seeds": [1, 2, 3, 4, 5],
  "outputDir": "./results/pilot-v1"
}
